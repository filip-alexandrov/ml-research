OPENMP DISPLAY ENVIRONMENT BEGIN
  _OPENMP = '201511'
  OMP_DYNAMIC = 'FALSE'
  OMP_NESTED = 'FALSE' <- no nested hyperthreading enabled
  OMP_NUM_THREADS = '4' <- because of dynamic will take over 100% resources (4 threads per process)
  OMP_SCHEDULE = 'DYNAMIC' <- default
  OMP_PROC_BIND = 'TRUE' <- each openmp thread will stay on its core / thread
  OMP_PLACES = '{0},{1},{2},{3}' <- cores used by OpenMP on this process, on hyperthreaded: {0, 16}, since hyperthreads have idx = # cores + n
  OMP_STACKSIZE = '0'
